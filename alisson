body {
  background-color: #f0f8ff; /* cor de fundo suave */
  color: #333333;            /* cor do texto principal */
  font-family: 'Segoe UI', Tahoma, sans-serif;
}

.header, .main-title {
  color: #2c3e50;
  font-size: 2.5rem;
}

.video-card {
  border: 2px solid #8e44ad;
  border-radius: 8px;
  overflow: hidden;
  transition: transform 0.2s ease;
}

.video-card:hover {
  transform: scale(1.05);
}

.video-card img {
  width: 100%;
  height: auto;
}

.video-card .title {
  background-color: #ecf0f1;
  padding: 10px;
  font-weight: bold;
  color: #2c3e50;
}

